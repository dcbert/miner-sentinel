# ===== DEPLOYMENT CONFIGURATION =====
# Docker registry (for production / docker-compose.prod.yml)
REGISTRY_URL=your-registry.com:5000
VERSION=1.0.0

# ===== DATABASE CONFIGURATION =====
POSTGRES_DB=minersentinel
POSTGRES_USER=minersentinel
POSTGRES_PASSWORD=changeme_secure_password_minimum_16_chars
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ===== DJANGO BACKEND =====
# Generate a long random string for production (django.core.management.utils.get_random_secret_key)
SECRET_KEY=generate-a-50-char-random-string-for-production-use-django-secret-key-generator
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com,your-server-ip
# Browser origins allowed to call the API (dev frontend is http://localhost:3000)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# Optional: override auto-created Django superuser (docker-compose.yml)
# DEFAULT_USERNAME=satoshi
# DEFAULT_PASSWORD=21millionBTC!
# DEFAULT_EMAIL=satoshi@example.com

# ===== DATA SERVICE =====
# Fallback/env hints; live intervals and pool/notification settings are stored in
# the collector_settings table and edited via Settings in the web UI.
POLLING_INTERVAL_MINUTES=15
DEVICE_CHECK_INTERVAL_MINUTES=5

# ===== FRONTEND (local Vite) =====
# Used by Vite dev server proxy and optional build-time config
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# Ports after `docker compose up` (development):
#   Frontend  http://localhost:3000
#   Backend   http://localhost:8000
#   Postgres  localhost:5432
# Umbrel package exposes the UI on port 3080.
